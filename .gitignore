# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
.worktrees/
.superpowers/

# Packaging and coverage artifacts
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Runtime data generated by the collector and feature pipeline
data/*.sqlite3
data/*.sqlite3-*
data/csv/*.csv
data/csv/*.tmp
data/raw/**/*.tmp
data/local-collector.log
data/*.lock

# Sensitive private-account data must remain local
.env
.env.*
!.env.example
data/account/
data/metadata/account_collector_status.json
data/metadata/private_collection_status.json
data/metadata/collector_runs/**/private.csv
data/modeling/p0_aligned_private_market.csv
data/modeling/p0_offer_lifecycle.csv
data/modeling/p0_offer_trade_matches.csv
data/modeling/p0_fixed_baselines.csv

# Local public-data synchronization runtime
data/archive/
data/metadata/public_git_sync_status.json
data/local_public/**/*.tmp
data/local_public/**/*.lock

# Disposable test synchronization workspaces
.test-tmp-sync-*/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
